{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./dist/cli/yan.js session-start",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./dist/hooks/turnend-guard.js --codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
