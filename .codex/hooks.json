{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": ["bash", "-c", "exec \"${CODEX_PROJECT_DIR:-.}/bin/yan\" session-start"],
        "timeout_ms": 120000
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": ["bash", "-c", "exec \"${CODEX_PROJECT_DIR:-.}/bin/hook-turnend-guard.sh\" --codex"],
        "timeout_ms": 30000
      }
    ]
  }
}
