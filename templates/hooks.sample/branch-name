#!/usr/bin/env bash
#
# conf/hooks/branch-name - SAMPLE (td boundaries.md §10).
#
# conf/hooks/ is gitignored, because it holds this machine's and this team's
# own choices and is not part of yan. So the sample ships one directory over,
# as conf/hooks.sample/branch-name. To use it:
#
#     mkdir -p "$YAN_HOME/conf/hooks"
#     cp "$YAN_HOME/conf/hooks.sample/branch-name" "$YAN_HOME/conf/hooks/"
#     chmod +x "$YAN_HOME/conf/hooks/branch-name"     # optional, see below
#
# The hook is entirely optional. With no hook installed, `yan unit add` uses
# its built-in default, yan/<task>-<unit>-r<n> (td branching.md §6.5). Install
# one when the integration branch's name is decided by something outside yan -
# a local script, a team convention, a ticket system.
#
# THE CONTRACT, and it is deliberately asymmetric:
#
#   in    JSON on stdin, so fields can be added later without breaking a hook
#         that is already installed:
#
#           { "task": "t042", "task_title": "unify the auth header",
#             "unit": "auth", "repo": "monorepo-x", "target": "master",
#             "scope": ["apps/auth"], "round": 1 }
#
#         Read only the fields you need. Ignore the rest, and do not fail when
#         a field you have never seen turns up.
#
#   out   ONE LINE on stdout: the branch name. If the hook chatters while it
#         works, that is fine - yan reads the LAST non-empty line, because a
#         hook is allowed to create or register the branch first and print its
#         name at the end.
#
#   exit  0        yan records the name and uses it as is; any shape is fine.
#         non-zero yan STOPS and reports. It never falls back to its built-in
#                  default. That is the point of installing a hook: after your
#                  tooling has refused, a branch quietly invented by yan would
#                  break your rules and might not be mergeable at all.
#
# The executable bit is optional. yan runs an executable hook directly (so a
# Python or Node hook works), and a non-executable one through bash - which is
# the normal case on Windows, where the bit usually does not survive a copy.
#
# yan never parses the name it gets back (td branching.md §6.6). It stores it
# in unit.branch and looks ownership up there; it does not split the string and
# it does not glob a prefix.
#
set -euo pipefail

ctx=$(cat)

get() { # get <jq path> - one field, or empty
	printf '%s' "$ctx" | jq -r "$1 // empty" | tr -d '\r'
}

task=$(get '.task')
unit=$(get '.unit')
target=$(get '.target')
round=$(get '.round')

: "${target:=master}"
: "${round:=1}"

# --- decide the name -------------------------------------------------------
#
# Replace this with whatever your team actually does. Three shapes people
# reach for, in rising order of how much they involve the outside world:
#
#   1. a convention          feat/<unit>
#   2. a convention that has to stay unique across rounds, because the
#      integration branch is replaced wholesale (td branching.md §6.3):
#                            feat/<unit>-r<round>
#   3. ask real tooling      name=$(ticket-cli branch-for "$task") || exit 1
#      - and note the `|| exit 1`: refusing is a first-class answer.
#
# Anything derived from `target` belongs here too, for a team that names
# release work differently from work headed for master.

case $target in
release/*) name="hotfix/${unit}" ;;
*) name="feat/${unit}" ;;
esac

if [ "$round" -gt 1 ] 2>/dev/null; then
	name="${name}-r${round}"
fi

# A hook may also create the branch itself, as long as it still prints the
# name. yan checks out a branch that already exists and cuts one that does
# not, so both halves of the contract work out the same way:
#
#   git -C "$YAN_HOME/repos/$repo" branch "$name" "origin/$target"

printf '%s\n' "$name"
