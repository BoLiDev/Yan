.DS_Store
node_modules/
*.log

# Runtime data lives in the same tree as the code (td INDEX.md §3), so each
# directory stays tracked through its .gitkeep while its contents never are.
# The `dir/*` form matters: git does not descend into an ignored directory, so
# `dir/` plus a negation would not work.

# user's local choices (td Appendix D). config.sample.json is the tracked one.
conf/config.json
conf/hooks/

mem/*
!mem/.gitkeep

tasks/*
!tasks/.gitkeep

repos/*
!repos/.gitkeep
