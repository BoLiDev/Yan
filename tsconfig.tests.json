{
  // The whole tree, tests included, type-checked and not built: what
  // `npm run typecheck` checks. `tsconfig.json` is the build, and leaves the
  // tests out so that its rootDir does not take tests/helpers/ into dist/;
  // without this the compiler would never see a test, and a promise a test
  // forgot to await would show only when it ran.
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true, "rootDir": "." },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": []
}
