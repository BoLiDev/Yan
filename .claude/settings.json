{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/bin/yan\" session-start",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/bin/hook-autoarm.sh\"",
            "asyncRewake": true,
            "timeout": 28800
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/bin/hook-turnend-guard.sh\" --claude",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
