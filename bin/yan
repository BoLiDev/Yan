#!/usr/bin/env bash
#
# yan - the single entry point shared by `user` and the agents (td INDEX.md,
# design principle 4).
#
# ---------------------------------------------------------------------------
# THIS FILE IS A STUB, AND THAT IS ALL IT IS
# ---------------------------------------------------------------------------
#
# yan is `dist/cli/yan.js`. What is left here is the three things that have to
# happen before node can be handed the command line, and it stays a shell script
# for one reason: `$YAN_HOME/bin/yan` is the path in .claude/settings.json, in
# .codex/hooks.json, in every shift's brief and in AGENTS.md, and a path that
# has been true since the MVP is not worth breaking to save an exec.
#
#   1  find $YAN_HOME
#   2  check the two hard dependencies
#   3  exec the compiled root, with the ORIGINAL words
#
# It used to be a dispatcher: `yan <cmd>` preferred `dist/cli/<cmd>.js` and fell
# back to `bin/yan-<cmd>.sh`, deriving both halves from a glob so that no phase
# had to edit a table here. That was the whole strangler (plan/INDEX.md §2), and
# it is over - Phase 8 removed the last shell command, so the fallback branch
# could only ever have found nothing. What it also carried, a hand-written usage
# text, is Commander's now and cannot drift from the real flags.
#
set -euo pipefail

yan_die() {
	printf 'yan: %s\n' "$1" >&2
	exit "${2:-1}"
}

# Absolute directory holding this script, with symlinks resolved.
yan_self_dir() {
	local src=${BASH_SOURCE[0]} dir
	while [ -L "$src" ]; do
		dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
		src=$(readlink "$src")
		case $src in
		/*) ;;
		*) src=$dir/$src ;;
		esac
	done
	cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}

# An exported $YAN_HOME wins, but only when it really is a yan home.
if [ -n "${YAN_HOME:-}" ] && [ -d "$YAN_HOME" ] && [ -f "$YAN_HOME/bin/yan" ]; then
	YAN_HOME=$(cd -P "$YAN_HOME" >/dev/null 2>&1 && pwd)
else
	YAN_HOME=$(dirname "$(yan_self_dir)")
fi
export YAN_HOME

# The two universal hard dependencies, checked inline so this stays cheap.
# `jq` is gone with the shell that needed it, and `node` has taken its place:
# yan starts Claude or Codex in a pane, so the machine has node anyway, and the
# no-hard-node-dependency promise of the MVP is formally withdrawn
# (docs/v2/td/INDEX.md §1). Everything else - the forge CLI, herdr - belongs to
# `yan doctor`.
for _yan_dep in git node; do
	command -v "$_yan_dep" >/dev/null 2>&1 ||
		yan_die "missing required dependency: $_yan_dep - install it, then run 'yan doctor'"
done
unset _yan_dep

YAN_ROOT_JS=$YAN_HOME/dist/cli/yan.js
[ -f "$YAN_ROOT_JS" ] ||
	yan_die "$YAN_ROOT_JS is missing - run 'npm run build' in $YAN_HOME"

exec node "$YAN_ROOT_JS" "$@"
