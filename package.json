{
  "name": "yan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "yan - one main agent per task, orchestrating single-use shifts. V2 runtime: TypeScript on Herdr.",
  "engines": {
    "node": ">=20.12.0"
  },
  "bin": {
    "yan": "bin/yan.mjs"
  },
  "scripts": {
    "build": "npm run lint:boundaries && tsc -p tsconfig.json",
    "lint:boundaries": "node scripts/check-module-boundaries.mjs",
    "types:herdr": "node scripts/generate-herdr-types.mjs",
    "types:herdr:check": "node scripts/generate-herdr-types.mjs --check",
    "typecheck": "tsc -p tsconfig.tests.json",
    "test": "npm run build && vitest run"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "commander": "14.0.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
