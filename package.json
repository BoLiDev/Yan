{
  "name": "yan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "yan - notes that outlive an agent session: tasks, their log and deliverables, and the agent started on them.",
  "engines": {
    "node": ">=20.12.0"
  },
  "bin": {
    "yan": "bin/yan.mjs"
  },
  "scripts": {
    "build": "npm run lint:boundaries && npm run clean && tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev:web": "vite --config web/vite.config.ts",
    "link": "npm link",
    "setup": "node scripts/setup.mjs",
    "lint:boundaries": "node scripts/check-module-boundaries.mjs",
    "typecheck": "tsc -p tsconfig.tests.json && tsc -p web/tsconfig.json",
    "test": "npm run build && vitest run"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "commander": "14.0.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.5",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "lucide-react": "1.66.0",
    "marked": "18.0.14",
    "oxlint": "1.90.0",
    "playwright": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0",
    "zustand": "5.0.16"
  }
}
