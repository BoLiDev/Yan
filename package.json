{
  "name": "yan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "yan - notes that outlive an agent session: tasks, their log and deliverables, and the agent started on them.",
  "engines": {
    "node": ">=20.12.0"
  },
  "bin": {
    "yan": "bin/yan.mjs"
  },
  "scripts": {
    "build": "npm run lint:boundaries && npm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "link": "npm link",
    "setup": "node scripts/setup.mjs",
    "lint:boundaries": "node scripts/check-module-boundaries.mjs",
    "typecheck": "tsc -p tsconfig.tests.json",
    "test": "npm run build && vitest run",
    "check:ui": "node scripts/check-ui-page.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "commander": "14.0.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
